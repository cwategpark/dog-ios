# 复制为 deploy/.env 后按环境填写；不要提交含真实密钥的 .env。
# Compose 会从本目录的 .env 读取 ${POSTGRES_PASSWORD} 等插值变量；
# 同时该文件通过 env_file 注入 api/migrate/worker 容器。
WAGELPAW_ENVIRONMENT=production
# 生产必须 PostgreSQL；密码需与下方 POSTGRES_PASSWORD 完全一致。
WAGELPAW_DATABASE_URL=postgresql+psycopg://wagelpaw:replace-with-strong-password@db:5432/wagelpaw
POSTGRES_USER=wagelpaw
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=wagelpaw
WAGELPAW_PUBLIC_BASE_URL=https://api.example.com
WAGELPAW_PUBLIC_ASSETS_DIR=/app/public-assets
WAGELPAW_STORAGE_PATH=/data/media
WAGELPAW_ALLOWED_SHOPS=["your-store.myshopify.com"]
WAGELPAW_ALLOWED_ORIGINS=[]
WAGELPAW_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# 必填：生产 Settings 拒绝空值。
WAGELPAW_SHOPIFY_API_SECRET=replace-with-shopify-api-secret
WAGELPAW_SHOPIFY_ACCESS_TOKEN=replace-with-shopify-admin-access-token
WAGELPAW_RATE_LIMIT_SALT=replace-with-a-separate-random-value
WAGELPAW_CLAIM_LINK_SECRET=
WAGELPAW_CLAIM_LINK_ENABLED=0
WAGELPAW_SMTP_HOST=
WAGELPAW_SMTP_PORT=587
WAGELPAW_SMTP_USERNAME=
WAGELPAW_SMTP_PASSWORD=
WAGELPAW_SMTP_FROM=
WAGELPAW_SMTP_USE_TLS=1
WAGELPAW_EXPOSE_DEV_OTP=0
WAGELPAW_DEV_EMAIL_OUTBOX=0
WAGELPAW_OTP_TTL_SECONDS=600
WAGELPAW_OTP_MAX_ATTEMPTS=5
WAGELPAW_ACCESS_TOKEN_TTL_SECONDS=900
WAGELPAW_REFRESH_TOKEN_TTL_SECONDS=2592000
WAGELPAW_DISCOVERY_LOCATION_TTL_SECONDS=86400
WAGELPAW_DISCOVERY_MAX_RADIUS_KM=25
