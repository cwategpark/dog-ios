<section class="section-wrap pet-tools" data-pet-tools data-fitting-module="{{ 'cat-fitting.js' | asset_url }}" data-root-url="{{ routes.root_url }}" data-cart-url="{{ routes.cart_url }}" data-proxy="{{ settings.app_proxy_path | escape }}" data-product-id="{{ product.id }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 }}{% endif %}" data-working="{{ 'assistant.working' | t }}" data-error="{{ 'assistant.error' | t }}" data-ready="{{ 'assistant.ready' | t }}" data-expired="{{ 'assistant.expired' | t }}"><script type="application/json" data-pet-copy>{"working":{{ 'assistant.working' | t | json }},"error":{{ 'assistant.error' | t | json }},"ready":{{ 'assistant.ready' | t | json }},"expired":{{ 'assistant.expired' | t | json }},"download":{{ 'assistant.download' | t | json }},"select":{{ 'assistant.select' | t | json }},"no_recommendations":{{ 'assistant.no_recommendations' | t | json }},"result_note":{{ 'assistant.result_note' | t | json }},"max_three":{{ 'assistant.max_three' | t | json }},"fit_confirm":{{ 'assistant.fit_confirm' | t | json }},"missing_fitting":{{ 'assistant.missing_fitting' | t | json }},"photos":{{ 'assistant.photo_preview' | t | json }},"claim_title":{{ copy_claim_title | json }},"claim_explain":{{ copy_claim_explain | json }},"claim_email":{{ copy_claim_email | json }},"claim_name":{{ copy_claim_name | json }},"claim_send":{{ copy_claim_send | json }},"claim_code":{{ copy_claim_code | json }},"claim_verify":{{ copy_claim_verify | json }},"claim_unverified":{{ copy_claim_unverified | json }},"claim_sent":{{ copy_claim_sent | json }},"claim_verified":{{ copy_claim_verified | json }},"claim_expired":{{ copy_claim_expired | json }},"claim_rate_limited":{{ copy_claim_rate_limited | json }},"claim_invalid_code":{{ copy_claim_invalid_code | json }},"claim_email_invalid":{{ copy_claim_email_invalid | json }},"claim_missing_email":{{ copy_claim_missing_email | json }},"claim_unavailable":{{ copy_claim_unavailable | json }},"claim_expires":{{ copy_claim_expires | json }},"claim_attempts_exceeded":{{ copy_claim_attempts_exceeded | json }},"claim_link_disabled":{{ copy_claim_link_disabled | json }},"claim_response_invalid":{{ copy_claim_response_invalid | json }}}</script><div class="pet-tools__intro"><p class="eyebrow">{% render 'theme-copy', value: section.settings.eyebrow %}</p><h2>{% render 'theme-copy', value: section.settings.heading %}</h2><p>{{ 'assistant.description' | t }}</p></div><div class="pet-tools__workspace"><form data-pet-profile><h3>{{ 'assistant.profile_title' | t }}</h3><fieldset><legend>{{ 'assistant.pet_type' | t }}</legend><label><input type="radio" name="type" value="dog" checked>{{ 'assistant.dog' | t }}</label><label><input type="radio" name="type" value="cat">{{ 'assistant.cat' | t }}</label></fieldset><label>{{ 'assistant.age' | t }}<input type="number" name="age_months" min="0" max="480" step="1" value="24" required></label><label data-dog-size>{{ 'assistant.size' | t }}<select name="dog_size"><option value="small">{{ 'assistant.small' | t }}</option><option value="medium">{{ 'assistant.medium' | t }}</option><option value="large">{{ 'assistant.large' | t }}</option></select></label><label>{{ copy_claim_email }}<input type="email" name="email" autocomplete="email" inputmode="email" maxlength="254"></label><label>{{ copy_claim_name }}<input type="text" name="full_name" autocomplete="name" maxlength="120"></label><label class="consent-label"><input name="consent" type="checkbox" required>{{ 'assistant.consent' | t }}</label><button class="button" type="submit">{{ 'assistant.save' | t }} ↗</button></form><div class="pet-tools__generation" data-generation-panel hidden><div class="pet-profile-saved"><h3>{{ 'assistant.saved' | t }}</h3><button type="button" class="text-link" data-profile-reset>{{ 'assistant.edit' | t }}</button></div><section class="pet-tools__claim" data-pet-claim hidden><h3>{{ copy_claim_title }}</h3><p class="form-note">{{ copy_claim_explain }}</p><p class="form-note" data-claim-email></p><button class="button" type="button" data-claim-send>{{ copy_claim_send }}</button><form class="pet-tools__claim-code" data-claim-verify hidden><label>{{ copy_claim_code }}<input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required></label><button class="button" type="submit">{{ copy_claim_verify }}</button></form><p class="pet-tools__status" role="status" aria-live="polite" data-claim-status></p></section><form data-pet-generation><label>{{ 'assistant.photo' | t }}<input type="file" name="file" accept="image/jpeg,image/png,image/webp" required></label><img class="pet-photo-preview" alt="{{ 'assistant.photo_preview' | t }}" data-photo-preview hidden width="240" height="240"><label>{{ 'assistant.choose' | t }}<select name="kind"><option value="tryon">{{ 'assistant.tryon' | t }}</option><option value="avatar">{{ 'assistant.avatar' | t }}</option><option value="cat-fitting">{{ 'assistant.fitting' | t }}</option></select></label><p class="form-note">{{ 'assistant.preview_note' | t }}</p><button type="submit" class="button">{{ 'assistant.generate' | t }} ↗</button></form><button class="text-link" type="button" data-recommend>{{ 'assistant.recommend' | t }} ↗</button><div class="pet-tools__results" data-pet-results></div></div><p class="pet-tools__status" role="status" aria-live="polite" data-pet-status></p></div></section>
{% endif %}
